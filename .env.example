# ========================================================
# Production & Deployment Environment Variables
# ========================================================

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codewithsuraj?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=generate_a_secure_random_64_character_string_here
JWT_EXPIRY=7d

# Razorpay (Optional - if using automated gateway)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Cloudinary (Required for Payment Screenshots & Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# App Info & Domain
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=CodeWithSuraj

# First-time Super Admin Setup Secret
ADMIN_SETUP_SECRET=change_this_to_a_secure_token_for_initial_admin_creation

# Manual UPI Payment Verification
NEXT_PUBLIC_UPI_ID=your_upi_id@bank
NEXT_PUBLIC_UPI_PAYEE_NAME=Your Legal Institute or Name
